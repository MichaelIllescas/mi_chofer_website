---
import logo from '../../assets/img/logo-removebg-preview (2).png';
import '../Navbar/Nav.css';
---
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm " id="nav">
  <div class="container">
    <!-- Logo sin texto -->
    <a href="#nav" class="navbar-brand d-flex align-items-center">
      <img src={logo.src} alt="Logo" class="navbar-logo me-2" />
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarContent"
      aria-controls="navbarContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
      
        <li class="nav-item">
          <a class="nav-link" href="#como-funciona">Cómo Funciona</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#beneficios">Beneficios</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#sobre-nosotros">Sobre Nosotros</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#faq">Preguntas Frecuentes</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#contacto">Contacto</a>
        </li>
      </ul>

      <!-- Botón CTA -->
      <a
        class="btn btn-primary ms-lg-3"
        href="https://wa.me/549XXXXXXXXXX"
        target="_blank"
      >
        Solicitar Servicio
      </a>
    </div>
  </div>
</nav>
