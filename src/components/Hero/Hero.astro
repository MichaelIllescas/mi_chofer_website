---
import "./hero.css";
import video from "../../assets/mp4/bg.mp4";
const phoneNumber = "5492392628465";
const message = "Hola, quiero hacer una consulta sobre mi chofer.";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<section class="hero" id="hero">
  <!-- Video de fondo -->
  <video class="bg-video" playsinline autoplay muted loop>
    <source src={video} type="video/mp4" />
  </video>

  <!-- Contenido encima del video -->
  <div class="masthead d-flex align-items-center">
    <div class="masthead-content text-white text-center w-100">
      <div class="container px-4 px-lg-0">
        <h1 class="display-4 fw-bold mb-4">
          Tu chofer privado, cuando lo necesites
        </h1>
        <p class="lead mb-5">
          Confiá en <bold>Mi Chofer </bold>para tus traslados seguros, puntuales y
          profesionales.
        </p>

        <!-- Botón CTA a WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          class="btn btn-lg btn-success px-4 py-2"
        >
          Pedí tu Chofer
        </a>
      </div>
    </div>
  </div>
</section>
