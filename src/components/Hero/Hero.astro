---
import "./hero.css";
import video from "../../assets/mp4/bg.mp4";
const phoneNumber = "5492392522277";
const message = "Hola, quiero hacer una consulta sobre mi chofer.";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---



<section class="hero" id="hero">
  <video class="hero-video" autoplay muted loop playsinline>
    <source src={video} type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-text">★ Servicio Premium</span>
    </div>
    <h1 class="hero-title">Tu chofer privado,<br><span>cuando lo necesites</span></h1>
    <p class="hero-desc">Confiá en <strong>Mi Chofer</strong> para tus traslados seguros, puntuales y profesionales.</p>
    <div class="hero-actions">
      <a href={whatsappUrl} target="_blank" class="hero-cta">Pedí tu Chofer</a>
      <a href="#como-funciona" class="hero-secondary">Cómo Funciona</a>
    </div>
    <div class="hero-features">
      <div class="feature-item">
        <span class="feature-icon">⏰</span>
        <h6>Disponible 24/7</h6>
        <p>Servicio las 24 horas</p>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🛡️</span>
        <h6>100% Seguro</h6>
        <p>Choferes verificados</p>
      </div>
      <div class="feature-item">
        <span class="feature-icon">📍</span>
        <h6>Seguimiento GPS</h6>
        <p>Ubicación en tiempo real</p>
      </div>
    </div>
    <div class="scroll-indicator">
      <a href="#como-funciona" class="scroll-link">
        <span class="scroll-icon">▼</span>
        <span class="scroll-text">Descubre más</span>
      </a>
    </div>
  </div>
</section>
