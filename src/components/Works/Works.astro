---
import car from "../../assets/img/auto.jpeg";
---

<!-- Works Section -->
<section class="conatiner my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card-shadow border-0">
        <img src={car.src} class="card-img-top" alt="my chofer service" />
        <div class="card-body">
          <h2 class="card-title h4">
            ¿No Quieres Manejar? Nosotros te llevamos.
          </h2>
          <p class="card-text">
            <strong>Mi Chofer</strong> es un servicio profesional de conductores
            privados ideal para cuando prefieresno estar al volante. Ya sea por comodidad,
            seguridad o responsabilidad, estamos listos para llevarte donde necesites.
          </p>
          <ul class="list-unstyled ms-3">
            <li>.</li>
            <li></li>
            <li></li>

          </ul>
        </div>
      </div>
    </div>
    <div></div>
  </div>
</section>
