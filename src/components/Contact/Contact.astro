---
import "../Contact/contact.css"; 
---



<section id="contacto" class="contact-section bg-light text-dark py-5">
  <div class="container px-4 px-lg-5">
    <h2 class="text-center text-dark mb-3">Contacto</h2>

    <div class="row justify-content-center">
      <!-- Formulario -->
      <div class="col-lg-6">
        <form>
          <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input
              type="text"
              class="form-control"
              id="nombre"
              placeholder="Tu nombre completo"
            />
          </div>
          <div class="mb-3">
            <label for="correo" class="form-label">Correo electrónico</label>
            <input
              type="email"
              class="form-control"
              id="correo"
              placeholder="ejemplo@correo.com"
            />
          </div>
          <div class="mb-3">
            <label for="mensaje" class="form-label">Mensaje</label>
            <textarea
              class="form-control"
              id="mensaje"
              rows="5"
              placeholder="Contanos cómo podemos ayudarte"
            ></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100"
            >Enviar consulta</button
          >
          <div id="form-message" class="mt-3"></div>
        </form>
      </div>

      <!-- Datos de contacto -->
      <div class="col-lg-5 mt-5 mt-lg-0">
        <div class="contact-info p-4 rounded bg-dark text-white shadow">
          <h5 class="mb-3">
            <i class="bi bi-whatsapp me-2 text-success"></i> WhatsApp
          </h5>

          <p class="mb-1 small text-secondary">Trenque Lauquen</p>
          <p class="mb-3">
            <a
              href="https://wa.me/5492392522277?text=Hola%2C%20quiero%20hacer%20una%20consulta%20sobre%20Mi%20Chofer%20en%20Trenque%20Lauquen."
              target="_blank"
              class="text-decoration-none text-white"
            >
              +54 9 2392-522277
            </a>
          </p>

          <p class="mb-1 small text-secondary">América</p>
          <p class="mb-3">
            <a
              href="https://wa.me/542392580599?text=Hola%2C%20quiero%20consultar%20por%20el%20servicio%20de%20Mi%20Chofer%20en%20Am%C3%A9rica."
              target="_blank"
              class="text-decoration-none text-white"
            >
              +54 9 2392-580599
            </a>
          </p>

          <p class="mb-1 small text-secondary">Pehuajó</p>
          <p class="mb-3">
            <a
              href="https://wa.me/542396633038?text=Hola%2C%20quiero%20consultar%20por%20el%20servicio%20de%20Mi%20Chofer%20en%20Pehuaj%C3%B3."
              target="_blank"
              class="text-decoration-none text-white"
            >
              +54 9 2396-633038
            </a>
          </p>

          <h5 class="mb-3">
            <i class="bi bi-envelope-fill me-2 text-info"></i> Email
          </h5>
          <p>contacto@michofer.com.ar</p>

          <h5 class="mb-3">
            <i class="bi bi-geo-alt-fill me-2 text-danger"></i> Zona de cobertura
          </h5>
          <p>Trenque Lauquen · América · Pehuajó</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../../../public/js/sendContact.js"></script>