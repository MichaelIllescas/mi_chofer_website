---
import ScrollButton from "../components/ScrollButton/ScrollButton.astro";
import WhatsaapButton from "../components/WhatsaapButton/WhatsaapButton.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Codificación -->
    <meta charset="UTF-8" />

    <!-- Responsivo en móviles -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Título SEO amigable -->
    <title>Chofer privado en Trenque Lauquen | Mi Chofer</title>

    <!-- Descripción SEO -->
    <meta
      name="description"
      content="Mi Chofer ofrece servicios de traslado personalizados, seguros y confiables para empresas y particulares en toda la ciudad."
    />

    <!-- Palabras clave (opcional, menor peso hoy en día) -->
    <meta
      name="keywords"
      content=" servicio de chofer, empresa de choferes, chofer en trenque lauquen, choferes en trenque lauquen,chofer, transporte privado, traslados ejecutivos, traslados seguros, servicio de chofer, Mi Chofer"
    />

    <!-- Autor y lenguaje -->
    <meta name="author" content="Mi Chofer" />
    <meta http-equiv="Content-Language" content="es" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fuente optimizada desde Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="https://michofer.com.ar/img/logo.jpeg"
      type="image/jpeg"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Mi Chofer",
        "image": "https://michofer.com.ar/img/logo.jpeg",
        "url": "https://michofer.com.ar",
        "telephone": "+54 9 2392 522277",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Trenque Lauquen",
          "addressRegion": "Buenos Aires",
          "addressCountry": "AR"
        },
        "description": "Servicio de chofer privado profesional en Trenque Lauquen. Traslados personalizados y seguros.",
        "openingHours": "Mo-Su 08:00-22:00",
        "priceRange": "$$"
      }
    </script>
  </head>

  <body>
    <div id="loader">
      <div class="spinner"></div>
    </div>
    <slot />
  </body>

  <script type="module" src="/js/loader.js" defer></script>
</html>
